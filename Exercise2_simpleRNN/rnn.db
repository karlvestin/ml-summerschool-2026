# ============================================================
# Minimal scalar-input recurrent neural network trend classifier
#
# Network:
#   XNORM = clamp((INPUT-XMIN)/(XMAX-XMIN), 0, 1)
#   DELTA = XNORM - PREV_XNORM
#
#   H1 = sigmoid(K*(-DELTA - EPS)      + R1*H1_PREV)
#   H2 = sigmoid(K*( EPS - ABS(DELTA)) + R2*H2_PREV)
#   H3 = sigmoid(K*( DELTA - EPS)      + R3*H3_PREV)
#
# Since H1, H2 and H3 are calc records, their previous VAL is used
# directly as H1_PREV, H2_PREV and H3_PREV.
#
#   FALLING_SUM = L1*H1 + L2*H2 + L3*H3 + LB
#   STABLE_SUM  = M1*H1 + M2*H2 + M3*H3 + MB
#   RISING_SUM  = H1O*H1 + H2O*H2 + H3O*H3 + HB
#
#   FALLING_PROB, STABLE_PROB, RISING_PROB =
#       softmax(FALLING_SUM, STABLE_SUM, RISING_SUM)
#
#   CLASS = argmax(FALLING_PROB, STABLE_PROB, RISING_PROB)
#   LABEL = FALLING, STABLE, or RISING
#
# Usage:
#   dbLoadRecords("rnn.db", "P=SYS:")
#
# Default weights detect falling, stable and rising trends.
# ============================================================


# ----------------------------
# Input scalar analogue value
# ----------------------------

record(ao, "$(P)RNN:INPUT") {
    field(DESC, "Scalar analogue input")
    field(DTYP, "Soft Channel")
    field(LOPR, "$(XMIN=0)")
    field(HOPR, "$(XMAX=100)")
    field(FLNK, "$(P)RNN:XNORM")
}


# ----------------------------
# Normalization
# ----------------------------

record(calc, "$(P)RNN:XNORM") {
    field(DESC, "Normalized NN input 0..1")
    field(INPA, "$(P)RNN:INPUT NPP")
    field(CALC, "((A-$(XMIN=0))/($(XMAX=100)-$(XMIN=0)))<0?0:((A-$(XMIN=0))/($(XMAX=100)-$(XMIN=0)))>1?1:((A-$(XMIN=0))/($(XMAX=100)-$(XMIN=0)))")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:H1SUM")
}


#--- hidden layer: h = sigmoid(Wxh*x + Whh*h_prev + bh) ---
# INPA = x_t ; INPB/C/D = h1/h2/h3 from the PREVIOUS tick (recurrence)
record(calc, "$(P)RNN:H1SUM") {
    field(DESC, "hidden1 pre-activation")
    field(INPA, "$(P)RNN:XNORM NPP")
    field(INPB, "$(P)RNN:H1P NPP")
    field(INPC, "$(P)RNN:H2P NPP")
    field(INPD, "$(P)RNN:H3P NPP")
    field(CALC, "2.610053*A-1.229400*B+0.389088*C+0.111757*D-0.993523") 
    field(FLNK, "$(P)RNN:H1")
}
record(calc, "$(P)RNN:H1") {
    field(DESC, "hidden1 sigmoid")
    field(INPA, "$(P)RNN:H1SUM NPP")
    field(CALC, "1/(1+EXP(-A))")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:H2SUM")
}
record(calc, "$(P)RNN:H2SUM") {
    field(DESC, "hidden2 pre-activation")
    field(INPA, "$(P)RNN:XNORM NPP")
    field(INPB, "$(P)RNN:H1P NPP")
    field(INPC, "$(P)RNN:H2P NPP")
    field(INPD, "$(P)RNN:H3P NPP")
    field(CALC,  "4.688208*A-10.916350*B+3.052341*C+0.845389*D+1.122133") 
    field(FLNK, "$(P)RNN:H2")
}
record(calc, "$(P)RNN:H2") {
    field(DESC, "hidden2 sigmoid")
    field(INPA, "$(P)RNN:H2SUM NPP")
    field(CALC, "1/(1+EXP(-A))")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:H3SUM")
}
record(calc, "$(P)RNN:H3SUM") {
    field(DESC, "hidden3 pre-activation")
    field(INPA, "$(P)RNN:XNORM NPP")
    field(INPB, "$(P)RNN:H1P NPP")
    field(INPC, "$(P)RNN:H2P NPP")
    field(INPD, "$(P)RNN:H3P NPP")
    field(CALC, "-15.884566*A+28.358418*B-7.387254*C-1.968287*D-1.157693") 
    field(FLNK, "$(P)RNN:H3")
}
record(calc, "$(P)RNN:H3") {
    field(DESC, "hidden3 sigmoid")
    field(INPA, "$(P)RNN:H3SUM NPP")
    field(CALC, "1/(1+EXP(-A))")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:Z1")
}

#--- output logits: z = Why*h + by ---
record(calc, "$(P)RNN:Z1") {
    field(DESC, "logit Increasing")
    field(INPA, "$(P)RNN:H1 NPP")
    field(INPB, "$(P)RNN:H2 NPP")
    field(INPC, "$(P)RNN:H3 NPP")
    field(CALC, "5.493579*A+18.733213*B-35.217319*C+2.195953") 
    field(FLNK, "$(P)RNN:Z2")
}
record(calc, "$(P)RNN:Z2") {
    field(DESC, "logit Stable")
    field(INPA, "$(P)RNN:H1 NPP")
    field(INPB, "$(P)RNN:H2 NPP")
    field(INPC, "$(P)RNN:H3 NPP")
    field(CALC, "1.113441*A-0.137917*B+1.186039*C+1.146973") 
    field(FLNK, "$(P)RNN:Z3")
}
record(calc, "$(P)RNN:Z3") {
    field(DESC, "logit Decreasing")
    field(INPA, "$(P)RNN:H1 NPP")
    field(INPB, "$(P)RNN:H2 NPP")
    field(INPC, "$(P)RNN:H3 NPP")
    field(CALC, "-7.128529*A-23.056977*B+34.451607*C-4.095017") 
    field(FLNK, "$(P)RNN:ZMAX")
}

#--- softmax (max-subtracted for numerical stability) ---
record(calc, "$(P)RNN:ZMAX") {
    field(DESC, "max logit")
    field(INPA, "$(P)RNN:Z1 NPP")
    field(INPB, "$(P)RNN:Z2 NPP")
    field(INPC, "$(P)RNN:Z3 NPP")
    field(CALC, "MAX(A,B,C)")
    field(FLNK, "$(P)RNN:Prob_Rising")
}
record(calc, "$(P)RNN:Prob_Rising") {
    field(DESC, "P(Increasing)")
    field(INPA, "$(P)RNN:Z1 NPP")
    field(INPB, "$(P)RNN:Z2 NPP")
    field(INPC, "$(P)RNN:Z3 NPP")
    field(INPD, "$(P)RNN:ZMAX NPP")
    field(CALC, "EXP(A-D)/(EXP(A-D)+EXP(B-D)+EXP(C-D))")
    field(PREC, "4")
    field(LOPR, "0")
    field(HOPR, "1")
    field(FLNK, "$(P)RNN:Prob_Stable")
}

record(calc, "$(P)RNN:Prob_Stable") {
    field(DESC, "P(Stable)")
    field(INPA, "$(P)RNN:Z1 NPP")
    field(INPB, "$(P)RNN:Z2 NPP")
    field(INPC, "$(P)RNN:Z3 NPP")
    field(INPD, "$(P)RNN:ZMAX NPP")
    field(CALC, "EXP(B-D)/(EXP(A-D)+EXP(B-D)+EXP(C-D))")
    field(PREC, "4")
    field(LOPR, "0")
    field(HOPR, "1")
    field(FLNK, "$(P)RNN:Prob_Falling")
}
record(calc, "$(P)RNN:Prob_Falling") {
    field(DESC, "P(Decreasing)")
    field(INPA, "$(P)RNN:Z1 NPP")
    field(INPB, "$(P)RNN:Z2 NPP")
    field(INPC, "$(P)RNN:Z3 NPP")
    field(INPD, "$(P)RNN:ZMAX NPP")
    field(CALC, "EXP(C-D)/(EXP(A-D)+EXP(B-D)+EXP(C-D))")
    field(PREC, "4")
    field(LOPR, "0")
    field(HOPR, "1")
    field(FLNK, "$(P)RNN:CLASS")
}

#--- argmax of the probabilities -> class index 0/1/2 ---
record(calc, "$(P)RNN:CLASS") {
    field(DESC, "argmax class index")
    field(INPA, "$(P)RNN:Prob_Rising NPP")
    field(INPB, "$(P)RNN:Prob_Stable NPP")
    field(INPC, "$(P)RNN:Prob_Falling NPP")
    field(CALC, "(A>=B)&&(A>=C)?0:(B>=C?1:2)")
    field(FLNK, "$(P)RNN:Prob_Rising_Stat")
}


record(calc, "$(P)RNN:Prob_Rising_Stat") {
    field(DESC, "P(Increasing)")
    field(INPA, "$(P)RNN:CLASS NPP")
    field(CALC, "A=0")
    field(FLNK, "$(P)RNN:Prob_Stable_Stat")
}

record(calc, "$(P)RNN:Prob_Stable_Stat") {
    field(DESC, "P(Stable)")
    field(INPA, "$(P)RNN:CLASS NPP")
    field(CALC, "A=1")
    field(FLNK, "$(P)RNN:Prob_Falling_Stat")
}
record(calc, "$(P)RNN:Prob_Falling_Stat") {
    field(DESC, "P(Decreasing)")
    field(INPA, "$(P)RNN:CLASS NPP")
    field(CALC, "A=2")
    field(FLNK, "$(P)RNN:Trend")
}

# Final human-readable trend (multi-bit binary input).
record(mbbi, "$(P)RNN:Trend") {
    field(DESC, "trend classification")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)RNN:CLASS NPP")
    field(NOBT, "2")
    field(ZRVL, "0")
    field(ZRST, "Increasing")
    field(ONVL, "1")
    field(ONST, "Stable")
    field(TWVL, "2")
    field(TWST, "Decreasing")
    field(ZRSV, "MAJOR")
    field(ONSV, "NO_ALARM")
    field(TWSV, "MINOR")
    field(FLNK, "$(P)RNN:H1P")
}

#--- latch hidden state for the next sample (the recurrence) ---
# Processed LAST, after the logits/softmax have already consumed the
# OLD h_prev, so these become h_{t-1} for the next clock tick.
record(calc, "$(P)RNN:H1P") {
    field(DESC, "h1(t-1) recurrent memory")
    field(INPA, "$(P)RNN:H1 NPP")
    field(CALC, "A")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:H2P")
}
record(calc, "$(P)RNN:H2P") {
    field(DESC, "h2(t-1) recurrent memory")
    field(INPA, "$(P)RNN:H2 NPP")
    field(CALC, "A")
    field(PREC, "5")
    field(FLNK, "$(P)RNN:H3P")
}
record(calc, "$(P)RNN:H3P") {
    field(DESC, "h3(t-1) recurrent memory")
    field(INPA, "$(P)RNN:H3 NPP")
    field(CALC, "A")
    field(PREC, "5")
}