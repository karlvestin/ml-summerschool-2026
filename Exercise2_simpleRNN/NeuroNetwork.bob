      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="New Rule" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>
            <color name="OK" red="65" green="229" blue="65">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>
            <color name="MINOR" red="255" green="235" blue="17">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>
            <color name="MAJOR" red="255" green="31" blue="26">
            </color>
          </value>
        </exp>
        <pv_name>SYS:RNN:CLASS</pv_name>
      </rule>
    </rules>
