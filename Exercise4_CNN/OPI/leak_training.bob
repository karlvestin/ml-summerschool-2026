  </widget>
  <widget type="label" version="2.0.0">
    <name>l_enable</name>
    <text>Sensors</text>
    <x>74</x>
    <y>596</y>
    <width>90</width>
    <height>34</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>btn_enable</name>
    <pv_name>$(P)Sim:Enable</pv_name>
    <x>164</x>
    <y>596</y>
    <width>150</width>
    <height>34</height>
    <off_label>Live PVs</off_label>
    <off_color>
      <color red="180" green="180" blue="180">
      </color>
    </off_color>
    <on_label>Simulated</on_label>
    <on_color>
      <color red="60" green="120" blue="200">
