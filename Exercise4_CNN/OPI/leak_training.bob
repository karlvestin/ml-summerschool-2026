  <widget type="label" version="2.0.0">
    <name>l_detectmatch</name>
    <text>Detection match (last sample)</text>
    <x>773</x>
    <y>550</y>
    <width>200</width>
    <height>26</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>v_detectmatch</name>
    <pv_name>$(P)Sim:DetectMatch</pv_name>
    <x>973</x>
    <y>550</y>
    <width>110</width>
    <height>26</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="detectmatch_bg" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="200" green="235" blue="205">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0!=1">
          <value>
            <color red="240" green="200" blue="200">
            </color>
          </value>
        </exp>
        <pv_name>$(P)Sim:DetectMatch</pv_name>
      </rule>
    </rules>
    <tooltip>Was the trustworthy leak-detected boolean correct on the last simulated sample? (Sim:DetectMatch: Correct/Wrong)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>l_match</name>
    <text>Last sample (exact location)</text>
    <x>773</x>
    <y>586</y>
    <width>200</width>
    <height>40</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
