    <y>661</y>
    <width>120</width>
    <height>34</height>
    <vertical_alignment>1</vertical_alignment>
    <tooltip>Sim:Mode — sequential or shuffled replay of dataset rows. The old continuous synthetic-rate dial is gone; replay is the only data source now.</tooltip>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>cmb_mode</name>
