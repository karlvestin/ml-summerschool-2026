  <widget type="action_button" version="3.0.0">
    <name>btn_reset</name>
    <actions>
      <action type="write_pv">
        <description>Zero the session scoreboard</description>
        <pv_name>$(P)Sim:Reset</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Reset scoreboard</text>
    <x>1014</x>
    <y>665</y>
    <width>250</width>
    <height>32</height>
    <tooltip>Zero NSamples / RunAcc / RunDetectAcc</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>training_details.bob</file>
        <target>window</target>
      </action>
    </actions>
    <text>Training details display</text>
    <x>654</x>
    <y>60</y>
    <width>190</width>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="16.0">
      </font>
    </font>
    <background_color>
      <color name="MASKED" red="255" green="175" blue="81">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>l_true</name>
    <text>TRUE location (simulated)</text>
    <x>830</x>
    <y>740</y>
    <width>290</width>
    <height>26</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>v_true</name>
    <pv_name>$(P)Sim:TrueLocation</pv_name>
    <x>830</x>
    <y>766</y>
    <width>290</width>
    <height>56</height>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="30.0">
      </font>
    </font>
    <foreground_color>
      <color red="30" green="130" blue="50">
      </color>
    </foreground_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>l_pred</name>
    <text>PREDICTED location (live or simulation)</text>
    <x>1130</x>
    <y>740</y>
    <width>290</width>
    <height>26</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>v_pred</name>
    <pv_name>$(P)LeakML:LocationHint</pv_name>
    <x>1130</x>
    <y>766</y>
    <width>290</width>
    <height>56</height>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="30.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="match_color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="30" green="140" blue="50">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0!=1">
          <value>
            <color red="180" green="40" blue="40">
            </color>
          </value>
        </exp>
        <pv_name>$(P)Sim:DetectMatch</pv_name>
      </rule>
    </rules>
    <tooltip>The trustworthy model output (leak vs no-leak), coloured by whether Sim:DetectMatch was correct on the last sample.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>note_gate</name>
    <text>This bench shows the TREE's advisory location on replayed data.</text>
    <x>830</x>
    <y>837</y>
    <width>580</width>
    <height>43</height>
    <font>
