<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Leak Prediction</name>
  <macros>
    <P>CWM-CWS02:WtrC-</P>
  </macros>
  <width>650</width>
  <height>820</height>
  <background_color>
    <color name="Interface Background" red="220" green="225" blue="221">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Titlebar</name>
    <class>TITLE-BAR</class>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>650</width>
    <height use_class="true">50</height>
    <line_width use_class="true">0</line_width>
    <background_color use_class="true">
      <color name="Standard_Title_Bar" red="151" green="188" blue="202">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>_ESS Class Title</class>
    <text>Cooling Skid — Leak Location Prediction</text>
    <x use_class="true">20</x>
    <y use_class="true">0</y>
    <width>630</width>
    <height use_class="true">50</height>
    <font use_class="true">
      <font name="_ESS Title" family="Source Sans Pro" style="BOLD_ITALIC" size="36.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment use_class="true">0</horizontal_alignment>
    <vertical_alignment use_class="true">1</vertical_alignment>
    <wrap_words use_class="true">false</wrap_words>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Stats BG</name>
    <x>20</x>
    <y>60</y>
    <width>610</width>
    <height>750</height>
    <line_width>0</line_width>
    <background_color>
      <color red="200" green="205" blue="201">
      </color>
    </background_color>
    <corner_width>10</corner_width>
    <corner_height>10</corner_height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Stats Header</name>
    <text>Model Performance</text>
    <x>20</x>
    <y>68</y>
    <width>440</width>
    <height>40</height>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="21.0">
      </font>
    </font>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Reload</name>
    <actions>
      <action type="write_pv">
        <description>Re-read meta JSON</description>
        <pv_name>$(P)Stats:Reload</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Reload stats</text>
    <x>460</x>
    <y>70</y>
    <width>150</width>
    <height>34</height>
    <tooltip>Re-read leak_model_meta.json into the Stats PVs</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lbl_testacc</name>
    <text>Test Accuracy (row-level, optimistic)</text>
    <x>40</x>
    <y>118</y>
    <width>420</width>
    <height>30</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>out_testacc</name>
    <pv_name>$(P)Stats:TestAcc</pv_name>
    <x>40</x>
    <y>148</y>
    <width>240</width>
    <height>64</height>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="36.0">
      </font>
    </font>
    <precision>2</precision>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="target_bg" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="200" green="235" blue="205">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0!=1">
          <value>
            <color red="240" green="200" blue="200">
            </color>
          </value>
        </exp>
        <pv_name>$(P)Stats:LevelGate</pv_name>
      </rule>
    </rules>
    <tooltip>Background reflects the Level-dominance physics gate (Stats:LevelGate) — a check that the model relies on level dynamics, not this accuracy value itself.</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
    <name>led_target</name>
    <pv_name>$(P)Stats:LevelGate</pv_name>
    <x>300</x>
    <y>158</y>
    <width>44</width>
    <height>44</height>
    <off_color>
      <color red="200" green="40" blue="40">
      </color>
    </off_color>
    <on_color>
      <color red="40" green="180" blue="60">
      </color>
    </on_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lbl_target</name>
    <text>Level-dominance gate (FAIL/PASS)</text>
    <x>352</x>
    <y>158</y>
    <width>250</width>
    <height>44</height>
    <vertical_alignment>1</vertical_alignment>
    <tooltip>Physics gate, not an accuracy target: verifies vessel-level dynamics (LI-103) dominate the model's feature importance (verification_gates.level_importance/level_pass in leak_model_meta.json), rather than the model latching onto a spurious correlate. See Stats:LevelGate.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lbl_balacc</name>
    <text>Balanced Acc (row-level, optimistic)</text>
