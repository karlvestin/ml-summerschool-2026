  <widget type="label" version="2.0.0">
    <name>l_perclass</name>
    <text>Per-class test accuracy (row-level, optimistic)</text>
    <x>40</x>
    <y>554</y>
    <width>460</width>
    <height>28</height>
    <font>
      <font family="Source Sans Pro" style="BOLD" size="14.0">
