  <widget type="xyplot" version="3.0.0">
    <name>perclass_plot</name>
    <x>40</x>
    <y>584</y>
    <width>560</width>
    <height>216</height>
    <background_color>
      <color red="255" green="255" blue="255">
      </color>
    </background_color>
    <tooltip>X = array index into Stats:ClassTestAcc / Stats:ClassLabel. Stats:ClassLabel is now a string waveform of location names — Phoebus xyplot has no native string-category axis, so this trace uses the implicit sample index (0-9); cross-reference Stats:ClassLabel for the name at each index.</tooltip>
    <x_axis>
      <title>leak location index (0-9; see Stats:ClassLabel)</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>false</show_grid>
      <title_font>
        <font name="Default Bold" family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Source Sans Pro" style="REGULAR" size="16.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>accuracy %</title>
        <autoscale>false</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>105.0</maximum>
        <show_grid>false</show_grid>
        <title_font>
          <font name="Default Bold" family="Source Sans Pro" style="BOLD" size="16.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Source Sans Pro" style="REGULAR" size="16.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="25" green="25" blue="25">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>per-class acc</name>
        <x_pv></x_pv>
        <y_pv>$(P)Stats:ClassTestAcc</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>7</point_type>
        <point_size>12</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
</display>
