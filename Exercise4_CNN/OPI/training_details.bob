      <color red="150" green="30" blue="30">
      </color>
    </foreground_color>
    <background_color>
      <color red="245" green="225" blue="225">
      </color>
    </background_color>
    <precision>1</precision>
    <vertical_alignment>1</vertical_alignment>
    <tooltip>0% by construction: each leak location is a single drain event, held out whole in LOEO — an instrumentation/observability gap (see P&amp;ID M02430), not a modelling failure.</tooltip>
  </widget>
